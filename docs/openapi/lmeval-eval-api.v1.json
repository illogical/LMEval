{
  "openapi": "3.1.0",
  "info": {
    "title": "LMEval Evaluation API",
    "version": "1.0.0",
    "description": "Machine-readable contract for the local LMEval API. Paths are relative to the deployment base path. Delete, git commit/revert, and promotion actions require separate explicit authorization."
  },
  "servers": [{ "url": "/api/eval" }],
  "tags": [
    { "name": "Evaluations" }, { "name": "Discovery" }, { "name": "Prompts" },
    { "name": "Test suites" }, { "name": "Templates" }, { "name": "Sessions" },
    { "name": "Presets" }, { "name": "Judges" }, { "name": "Model selection" }, { "name": "Git" }
  ],
  "paths": {
    "/health": { "get": { "tags": ["Discovery"], "summary": "Service health", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/openapi.json": { "get": { "tags": ["Discovery"], "summary": "This OpenAPI document", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/models": { "get": { "tags": ["Discovery"], "summary": "Flat loaded model names", "responses": { "200": { "description": "Flat compatibility response", "content": { "application/json": { "schema": { "type": "object", "required": ["models"], "properties": { "models": { "type": "array", "items": { "type": "string" } } } }, "example": { "models": ["model-a"] } } } } } } },
    "/models/by-server": { "get": { "tags": ["Discovery"], "summary": "Canonical server-pinned model discovery", "responses": { "200": { "description": "Online servers and models", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GroupedModels" }, "example": { "servers": [{ "name": "local", "models": ["model-a"] }] } } } }, "502": { "$ref": "#/components/responses/Error" } } } },
    "/models/leaderboard": { "get": { "tags": ["Discovery"], "summary": "Historical model leaderboard", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },

    "/evaluations": {
      "get": { "tags": ["Evaluations"], "summary": "List evaluations", "parameters": [{ "name": "status", "in": "query", "schema": { "type": "string" } }, { "name": "promptId", "in": "query", "schema": { "type": "string" } }, { "name": "modelId", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "$ref": "#/components/responses/Json" } } },
      "post": { "tags": ["Evaluations"], "summary": "Backward-compatible create and start", "requestBody": { "$ref": "#/components/requestBodies/EvaluationInput" }, "responses": { "202": { "description": "Pending evaluation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EvaluationConfig" } } } }, "400": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } } }
    },
    "/evaluations/validate": { "post": { "tags": ["Evaluations"], "summary": "Validate without persisting", "requestBody": { "$ref": "#/components/requestBodies/EvaluationInput" }, "responses": { "200": { "description": "Validation result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Validation" } } } }, "503": { "$ref": "#/components/responses/Error" } } } },
    "/evaluations/drafts": { "post": { "tags": ["Evaluations"], "summary": "Create a reviewable draft without model calls", "requestBody": { "$ref": "#/components/requestBodies/EvaluationInput" }, "responses": { "201": { "$ref": "#/components/responses/Draft" }, "400": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } } } },
    "/evaluations/baselines": { "get": { "tags": ["Evaluations"], "summary": "List saved baselines", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/evaluations/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": { "tags": ["Evaluations"], "summary": "Get evaluation configuration", "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" } } },
      "patch": { "tags": ["Evaluations"], "summary": "Patch a draft", "requestBody": { "$ref": "#/components/requestBodies/EvaluationPatch" }, "responses": { "200": { "$ref": "#/components/responses/Draft" }, "400": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } },
      "delete": { "tags": ["Evaluations"], "summary": "Permanently delete an evaluation", "x-destructive": true, "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" } } }
    },
    "/evaluations/{id}/run": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "tags": ["Evaluations"], "summary": "Start a draft exactly once", "responses": { "202": { "$ref": "#/components/responses/Draft" }, "409": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } } } },
    "/evaluations/{id}/feedback": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "tags": ["Evaluations"], "summary": "Pollable durable orchestration and recovery snapshot", "responses": { "200": { "description": "Feedback snapshot", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Feedback" } } } }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/evaluations/{id}/resume": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "tags": ["Evaluations"], "summary": "Resume unfinished exact cells in the same evaluation", "description": "Performs a read-only compatibility/catalog preflight, creates a durable attempt, reuses valid checkpoints, and returns before remaining provider work completes.", "responses": { "202": { "description": "Durable resume attempt accepted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResumeResponse" } } } }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/evaluations/{id}/results": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "tags": ["Evaluations"], "summary": "Detailed result cells", "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/evaluations/{id}/summary": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "tags": ["Evaluations"], "summary": "Aggregate summary", "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/evaluations/{id}/testcases": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "tags": ["Evaluations"], "summary": "Resolved cases actually run", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/evaluations/{id}/history": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "tags": ["Evaluations"], "summary": "Related evaluation history", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/evaluations/{id}/regression": { "parameters": [{ "$ref": "#/components/parameters/Id" }, { "name": "baselineSlug", "in": "query", "required": true, "schema": { "type": "string" } }], "get": { "tags": ["Evaluations"], "summary": "Compare with a saved baseline", "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/evaluations/{id}/cancel": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "tags": ["Evaluations"], "summary": "Request cancellation without deleting checkpoints", "responses": { "202": { "$ref": "#/components/responses/Json" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/evaluations/{id}/retry": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "tags": ["Evaluations"], "summary": "Create a retry evaluation", "responses": { "202": { "$ref": "#/components/responses/Json" } } } },
    "/evaluations/{id}/summary-analysis": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "tags": ["Evaluations"], "summary": "Get cached summary analysis", "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" } } }, "post": { "tags": ["Evaluations"], "summary": "Generate summary analysis", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/evaluations/{id}/export": { "parameters": [{ "$ref": "#/components/parameters/Id" }, { "name": "format", "in": "query", "schema": { "type": "string", "enum": ["html", "md"] } }], "get": { "tags": ["Evaluations"], "summary": "Export report", "responses": { "200": { "description": "HTML or Markdown report" } } } },
    "/evaluations/{id}/baseline": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "tags": ["Evaluations"], "summary": "Save summary as baseline", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },

    "/prompts": { "get": { "tags": ["Prompts"], "summary": "List prompts", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "tags": ["Prompts"], "summary": "Create prompt", "responses": { "201": { "$ref": "#/components/responses/Json" } } } },
    "/prompts/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "tags": ["Prompts"], "summary": "Get prompt manifest", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "delete": { "tags": ["Prompts"], "summary": "Delete prompt", "x-destructive": true, "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/prompts/{id}/content": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "tags": ["Prompts"], "summary": "Get prompt version content", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/prompts/{id}/versions": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "tags": ["Prompts"], "summary": "Add prompt version", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/prompts/{id}/diff": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "tags": ["Prompts"], "summary": "Diff prompt versions", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/prompts/{id}/tools": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "put": { "tags": ["Prompts"], "summary": "Replace prompt tools", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/prompts/{id}/history": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "tags": ["Prompts"], "summary": "Prompt evaluation history", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },

    "/templates": { "get": { "tags": ["Templates"], "summary": "List judge templates", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "tags": ["Templates"], "summary": "Create judge template", "responses": { "201": { "$ref": "#/components/responses/Json" } } } },
    "/templates/generate": { "post": { "tags": ["Templates"], "summary": "Generate an unpersisted template", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/templates/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "tags": ["Templates"], "summary": "Get judge template", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "put": { "tags": ["Templates"], "summary": "Update custom judge template", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "delete": { "tags": ["Templates"], "summary": "Delete custom judge template", "x-destructive": true, "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/purpose-templates": { "get": { "tags": ["Templates"], "summary": "List purpose templates", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "tags": ["Templates"], "summary": "Create custom purpose template", "responses": { "201": { "$ref": "#/components/responses/Json" } } } },
    "/purpose-templates/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "tags": ["Templates"], "summary": "Get purpose template", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "put": { "tags": ["Templates"], "summary": "Update custom purpose template", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "delete": { "tags": ["Templates"], "summary": "Delete custom purpose template", "x-destructive": true, "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/test-suites": { "get": { "tags": ["Test suites"], "summary": "List suites", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "tags": ["Test suites"], "summary": "Create custom suite", "responses": { "201": { "$ref": "#/components/responses/Json" } } } },
    "/test-suites/parse": { "post": { "tags": ["Test suites"], "summary": "Parse CSV or JSON test cases", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/test-suites/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "tags": ["Test suites"], "summary": "Get suite", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "put": { "tags": ["Test suites"], "summary": "Update custom suite", "responses": { "200": { "$ref": "#/components/responses/Json" }, "403": { "$ref": "#/components/responses/Error" } } }, "delete": { "tags": ["Test suites"], "summary": "Delete custom suite", "x-destructive": true, "responses": { "200": { "$ref": "#/components/responses/Json" }, "403": { "$ref": "#/components/responses/Error" } } } },

    "/presets": { "get": { "tags": ["Presets"], "summary": "List presets", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "tags": ["Presets"], "summary": "Create preset", "responses": { "201": { "$ref": "#/components/responses/Json" } } } },
    "/presets/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "tags": ["Presets"], "summary": "Get preset", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "patch": { "tags": ["Presets"], "summary": "Patch preset", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "delete": { "tags": ["Presets"], "summary": "Delete preset", "x-destructive": true, "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/judges/{modelId}/qualification": { "parameters": [{ "$ref": "#/components/parameters/ModelId" }], "get": { "tags": ["Judges"], "summary": "Get judge qualification", "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/judges/{modelId}/qualify": { "parameters": [{ "$ref": "#/components/parameters/ModelId" }], "post": { "tags": ["Judges"], "summary": "Run judge qualification", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/judges/{modelId}/qualification-status": { "parameters": [{ "$ref": "#/components/parameters/ModelId" }], "get": { "tags": ["Judges"], "summary": "Get current qualification and latest persisted run", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/judges/{modelId}/qualification-runs": { "parameters": [{ "$ref": "#/components/parameters/ModelId" }], "post": { "tags": ["Judges"], "summary": "Start an asynchronous qualification run", "responses": { "202": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/judges/qualification-runs/{runId}": { "parameters": [{ "name": "runId", "in": "path", "required": true, "schema": { "type": "string" } }], "get": { "tags": ["Judges"], "summary": "Get a persisted qualification run", "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/judges/qualification-runs/{runId}/cancel": { "parameters": [{ "name": "runId", "in": "path", "required": true, "schema": { "type": "string" } }], "post": { "tags": ["Judges"], "summary": "Request qualification cancellation", "responses": { "202": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },

    "/sessions": { "get": { "tags": ["Sessions"], "summary": "List sessions", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "tags": ["Sessions"], "summary": "Create session", "responses": { "201": { "$ref": "#/components/responses/Json" } } } },
    "/sessions/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "tags": ["Sessions"], "summary": "Get session", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "delete": { "tags": ["Sessions"], "summary": "Delete session", "x-destructive": true, "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/sessions/{id}/active": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "tags": ["Sessions"], "summary": "Get active session version", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/sessions/{id}/versions": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "tags": ["Sessions"], "summary": "Add session version", "responses": { "201": { "$ref": "#/components/responses/Json" } } } },
    "/sessions/{id}/versions/{version}": { "parameters": [{ "$ref": "#/components/parameters/Id" }, { "name": "version", "in": "path", "required": true, "schema": { "type": "integer" } }], "get": { "tags": ["Sessions"], "summary": "Get session version", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/sessions/{id}/latest": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "put": { "tags": ["Sessions"], "summary": "Select latest session version", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/sessions/{id}/runs": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "tags": ["Sessions"], "summary": "List session runs", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "tags": ["Sessions"], "summary": "Link a session run", "responses": { "201": { "$ref": "#/components/responses/Json" } } } },
    "/sessions/{id}/runs/{runId}": { "parameters": [{ "$ref": "#/components/parameters/Id" }, { "name": "runId", "in": "path", "required": true, "schema": { "type": "string" } }], "patch": { "tags": ["Sessions"], "summary": "Update session run", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },

    "/model-selection": { "get": { "tags": ["Model selection"], "summary": "List campaigns", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "post": { "tags": ["Model selection"], "summary": "Create and start campaign", "responses": { "202": { "$ref": "#/components/responses/Json" } } } },
    "/model-selection/validate": { "post": { "tags": ["Model selection"], "summary": "Validate and estimate a campaign without persisting", "responses": { "200": { "$ref": "#/components/responses/Json" }, "503": { "$ref": "#/components/responses/Error" } } } },
    "/model-selection/drafts": { "post": { "tags": ["Model selection"], "summary": "Save a validated campaign draft", "responses": { "201": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } } } },
    "/model-selection/drafts/from-evaluation": { "post": { "tags": ["Model selection"], "summary": "Create a campaign draft from a compatible evaluation draft", "description": "Copies purpose, pinned prompts, benchmark suite, and judge context. The source evaluation is associated as supplemental evidence and never becomes a protocol phase.", "responses": { "201": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } } } },
    "/model-selection/latency-budgets": { "get": { "tags": ["Model selection"], "summary": "Get latency budgets", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "put": { "tags": ["Model selection"], "summary": "Replace latency budgets", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/model-selection/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "tags": ["Model selection"], "summary": "Get campaign", "responses": { "200": { "$ref": "#/components/responses/Json" } } }, "patch": { "tags": ["Model selection"], "summary": "Replace editable campaign draft fields", "responses": { "200": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/model-selection/{id}/run": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "tags": ["Model selection"], "summary": "Start a validated draft after warning acknowledgement", "responses": { "202": { "$ref": "#/components/responses/Json" }, "400": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/model-selection/{id}/feedback": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "tags": ["Model selection"], "summary": "Get lifecycle, validation, phase links, and active progress", "responses": { "200": { "$ref": "#/components/responses/Json" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/model-selection/{id}/recommendations": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "tags": ["Model selection"], "summary": "Get recommendations", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/model-selection/{id}/cancel": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "tags": ["Model selection"], "summary": "Cancel campaign", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },

    "/git/status": { "get": { "tags": ["Git"], "summary": "Nested data repository status", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/git/log": { "get": { "tags": ["Git"], "summary": "Nested data repository history", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/git/init": { "post": { "tags": ["Git"], "summary": "Initialize nested data repository", "x-destructive": true, "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/git/commit": { "post": { "tags": ["Git"], "summary": "Explicitly commit nested data changes", "x-destructive": true, "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/git/revert": { "post": { "tags": ["Git"], "summary": "Explicitly revert a nested data commit", "x-destructive": true, "responses": { "200": { "$ref": "#/components/responses/Json" } } } }
  },
  "components": {
    "parameters": {
      "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
      "ModelId": { "name": "modelId", "in": "path", "required": true, "schema": { "type": "string", "description": "URL-encoded server::model identifier" } }
    },
    "requestBodies": {
      "EvaluationInput": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EvaluationInput" }, "example": { "name": "Classification smoke", "promptIds": ["prompt-1"], "modelIds": ["local::model-a"], "comparisonMode": "matrix", "inlineTestCases": [{ "id": "case-1", "userMessage": "<memory>Example</memory>", "expectedLabels": ["Note"] }], "runsPerCell": 1, "inference": { "temperature": 0.3, "maxTokens": 1000 } } } } },
      "EvaluationPatch": { "required": true, "content": { "application/json": { "schema": { "type": "object", "description": "Any caller-controlled EvaluationInput fields; validation applies to the merged draft." } } } }
    },
    "responses": {
      "Json": { "description": "JSON response", "content": { "application/json": { "schema": {} } } },
      "Error": { "description": "Machine-readable error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" }, "example": { "error": "Evaluation configuration is invalid", "code": "EVALUATION_VALIDATION_FAILED" } } } },
      "Draft": { "description": "Evaluation resource and validation", "content": { "application/json": { "schema": { "type": "object", "required": ["evaluation", "validation", "browserPaths"], "properties": { "evaluation": { "$ref": "#/components/schemas/EvaluationConfig" }, "validation": { "$ref": "#/components/schemas/Validation" }, "browserPaths": { "$ref": "#/components/schemas/BrowserPaths" } } } } } }
    },
    "schemas": {
      "GroupedModels": { "type": "object", "required": ["servers"], "properties": { "servers": { "type": "array", "items": { "type": "object", "required": ["name", "models"], "properties": { "name": { "type": "string" }, "models": { "type": "array", "items": { "type": "string" } } } } } } },
      "Inference": { "type": "object", "required": ["temperature", "maxTokens"], "properties": { "temperature": { "type": "number", "minimum": 0, "maximum": 2 }, "maxTokens": { "type": "integer", "minimum": 1, "maximum": 1000000 }, "seed": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 } } },
      "PromptVersion": { "type": "object", "required": ["promptId", "version"], "properties": { "promptId": { "type": "string" }, "version": { "type": "integer", "minimum": 1 } } },
      "EvaluationInput": { "type": "object", "required": ["name", "promptIds", "modelIds"], "properties": { "name": { "type": "string", "minLength": 1 }, "promptIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "promptVersions": { "type": "array", "items": { "$ref": "#/components/schemas/PromptVersion" } }, "modelIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^.+::.+$" } }, "comparisonMode": { "type": "string", "enum": ["model", "prompt", "matrix"] }, "purposeTemplateId": { "type": "string" }, "testSuiteId": { "type": "string" }, "userMessage": { "type": "string" }, "inlineTestCases": { "type": "array", "items": { "type": "object" } }, "templateId": { "type": "string" }, "judgeModelId": { "type": "string" }, "enablePairwise": { "type": "boolean" }, "runsPerCell": { "type": "integer", "minimum": 1, "maximum": 10 }, "sessionId": { "type": "string" }, "sessionVersion": { "type": "integer" }, "inference": { "$ref": "#/components/schemas/Inference" }, "benchmarkMode": { "type": "string", "enum": ["calibration", "promotion-check"] }, "campaignId": { "type": "string" }, "campaignRole": { "type": "string", "enum": ["supplemental"] } } },
      "EvaluationConfig": { "allOf": [{ "$ref": "#/components/schemas/EvaluationInput" }, { "type": "object", "required": ["id", "status", "createdAt", "updatedAt"], "properties": { "id": { "type": "string" }, "status": { "type": "string", "enum": ["draft", "pending", "running", "interrupted", "completed", "failed", "cancelled"] }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" } } }] },
      "ValidationIssue": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "field": { "type": "string" }, "message": { "type": "string" } } },
      "Validation": { "type": "object", "required": ["valid", "errors", "warnings"], "properties": { "valid": { "type": "boolean" }, "errors": { "type": "array", "items": { "$ref": "#/components/schemas/ValidationIssue" } }, "warnings": { "type": "array", "items": { "$ref": "#/components/schemas/ValidationIssue" } } } },
      "BrowserPaths": { "type": "object", "required": ["config", "run", "results", "summary"], "properties": { "config": { "type": "string" }, "run": { "type": "string" }, "results": { "type": "string" }, "summary": { "type": "string" } } },
      "Recovery": { "type": "object", "required": ["state", "reusedCells", "remainingCells", "requiresModelCalls"], "properties": { "state": { "type": "string", "enum": ["not-needed", "eligible", "finalization-only", "blocked", "legacy-unrecoverable"] }, "reasonCode": { "type": "string" }, "reusedCells": { "type": "integer" }, "remainingCells": { "type": "integer" }, "lastAttemptId": { "type": "string" }, "requiresModelCalls": { "type": "boolean" } } },
      "Feedback": { "type": "object", "required": ["evalId", "status", "progress", "validation", "failures", "readiness", "appBasePath", "browserPaths"], "properties": { "evalId": { "type": "string" }, "status": { "type": "string" }, "progress": { "type": "object", "description": "Includes checkpoint-derived durablyCommitted and remaining for schema-v1 runs." }, "validation": { "$ref": "#/components/schemas/Validation" }, "failures": { "type": "array", "items": { "type": "object" } }, "readiness": { "type": "object" }, "verdict": { "type": ["object", "null"] }, "attempt": { "type": "object" }, "recovery": { "$ref": "#/components/schemas/Recovery" }, "appBasePath": { "type": "string" }, "browserPaths": { "$ref": "#/components/schemas/BrowserPaths" } } },
      "ResumeResponse": { "type": "object", "required": ["evaluationId", "attemptId", "mode", "counts", "preflight", "browserPaths"], "properties": { "evaluationId": { "type": "string" }, "attemptId": { "type": "string" }, "resumedFromAttemptId": { "type": "string" }, "mode": { "type": "string", "enum": ["execute-remaining", "finalization-only"] }, "counts": { "type": "object" }, "preflight": { "type": "object" }, "browserPaths": { "$ref": "#/components/schemas/BrowserPaths" } } },
      "Error": { "type": "object", "required": ["error", "code"], "properties": { "error": { "type": "string" }, "code": { "type": "string" }, "reasonCode": { "type": "string" }, "checks": { "type": "array", "items": { "type": "object" } }, "validation": { "$ref": "#/components/schemas/Validation" } } }
    }
  }
}
