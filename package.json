{
  "name": "my-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch --ignore \"data/**\" server/index.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "build:hosted": "tsc -b && cross-env VITE_BASE_PATH=/lmeval/ vite build",
    "build:host": "esbuild server/host/index.ts --bundle --platform=node --format=esm --outfile=dist/host/index.js --packages=external",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:api": "tsx scripts/test-api.ts",
    "test:sessions": "tsx scripts/test-sessions.ts",
    "test:execution": "tsx scripts/test-execution.ts",
    "test:e2e-api": "tsx scripts/e2e-api.ts",
    "test:e2e-ui": "playwright test",
    "test:e2e-ui:headed": "playwright test --headed",
    "test:agent-workflow": "tsx scripts/test-agent-workflow.ts",
    "test:all": "npm run test && npm run test:e2e-api && npm run test:e2e-ui",
    "benchmarks:generate": "tsx scripts/generate-memory-benchmarks.ts",
    "benchmarks:lint": "tsx scripts/lint-memory-benchmarks.ts"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "cors": "^2.8.5",
    "diff": "^8.0.3",
    "express": "^5.2.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.577.0",
    "promptfoo": "^0.122.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "ws": "^8.21.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.17",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/coverage-v8": "^4.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  }
}
